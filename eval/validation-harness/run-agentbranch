#!/usr/bin/env node
/**
 * Thin deterministic AgentBranch Runner for the validation-harness smevals PoC
 * (agentbranch #301). Executed by smevals once per Task/Config/model with no
 * arguments; everything arrives via environment variables:
 *   SMEVALS_MODEL, SMEVALS_TASK, SMEVALS_PROMPT, SMEVALS_TASK_<KEY>, SMEVALS_RUN_DIR
 *
 * This is a *mock*: it deterministically simulates an agent configuration's
 * behaviour for each scenario instead of calling a real model, so the PoC runs
 * offline with zero model spend and zero credentials. It writes the retained
 * evidence contract into SMEVALS_RUN_DIR:
 *   trace.json                  provider-neutral trace (TranscriptStep-shaped:
 *                               {kind: model|tool-call|tool-result})
 *   agent-configuration.json    fully resolved agent configuration, no secrets
 *   artifacts.json              tool, delegation, and recovery outputs
 *   harness-version.json        harness version identity
 *   timing.json                 started_at / completed_at / duration_ms
 *   usage.json                  simulated token/cost fields (marked simulated)
 *   completion.json             completion status + exit code
 * and prints the final response to stdout (captured as output.txt by smevals).
 *
 * A task with `expect_infra_failure: true` simulates a harness/infrastructure
 * failure: it exits non-zero (retained for diagnosis, never graded).
 *
 * The provider-neutral trace envelope intentionally mirrors TranscriptStep in
 * src/modules/test-run (model | tool-call | tool-result) — the explicitly
 * mapped removable adapter around the existing seam; this PoC never imports src.
 */
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { basename, dirname, join } from "node:path";
import { parse as parseYaml } from "yaml";
import { runDeterministicAdapter } from "./deterministic-runtime-adapter.mjs";
import {
  credentialFreeAgentConfiguration,
  executionArtifactsFromTrace,
  mapAgentTurnToTrace,
} from "./runner-contract.mjs";

const { SMEVALS_RUN_DIR, SMEVALS_MODEL, SMEVALS_TASK, SMEVALS_PROMPT } = process.env;
if (!SMEVALS_RUN_DIR) {
  console.error("SMEVALS_RUN_DIR is required");
  process.exit(42);
}

function taskKey(key) {
  return process.env[`SMEVALS_TASK_${key.replace(/[^A-Za-z0-9]+/g, "_").toUpperCase()}`];
}

// Derive the config name from the run dir path: runs/<task>/<config>/<model>/<timestamp>.
const configName = basename(dirname(dirname(SMEVALS_RUN_DIR)));
// This runner lives at eval/validation-harness/run-agentbranch.
const evalDir = dirname(process.argv[1]);
const configPath = join(evalDir, "configs", `${configName}.yaml`);
const startedAt = new Date().toISOString();
const t0 = Date.now();

let config = {
  model: SMEVALS_MODEL,
  agent_configuration_id: "unknown",
  harness_version: "unknown",
  agent_configuration: null,
};
let configurationFailure = null;
if (existsSync(configPath)) {
  try {
    const parsed = parseYaml(readFileSync(configPath, "utf8"));
    config = { ...config, ...parsed };
  } catch (error) {
    configurationFailure = error;
  }
}
const harnessVersion = config.harness_version ?? "unknown";

const scenario = taskKey("scenario") ?? "unknown";
const skill = taskKey("skill");
const expectedTool = taskKey("expected_tool");
const expectedArgs = taskKey("expected_args");
const delegateTo = taskKey("delegate_to");
const forbiddenTool = taskKey("forbidden_tool");
const flakyTool = taskKey("flaky_tool");
// smevals passes scalar task keys via Python's str(), so a YAML true becomes
// the string "True". Accept both casings and the numeric form.
const expectInfraFailure = ["true", "True", "1"].includes(taskKey("expect_infra_failure"));

function writeArtifacts(turn, status, exitCode, failure = null, stderr = "") {
  const durationMs = Date.now() - t0;
  const completedAt = new Date().toISOString();
  const providerNeutralTrace = mapAgentTurnToTrace(turn);
  const resolvedConfiguration = credentialFreeAgentConfiguration(config.agent_configuration);
  writeFileSync(join(SMEVALS_RUN_DIR, "trace.json"), JSON.stringify(providerNeutralTrace, null, 2) + "\n");
  writeFileSync(
    join(SMEVALS_RUN_DIR, "agent-configuration.json"),
    JSON.stringify(resolvedConfiguration, null, 2) + "\n",
  );
  writeFileSync(
    join(SMEVALS_RUN_DIR, "artifacts.json"),
    JSON.stringify(executionArtifactsFromTrace(providerNeutralTrace), null, 2) + "\n",
  );
  writeFileSync(
    join(SMEVALS_RUN_DIR, "harness-version.json"),
    JSON.stringify(
      {
        harness_version: harnessVersion,
        runner_contract_version: "1",
        source: `eval/validation-harness/configs/${configName}.yaml`,
      },
      null,
      2,
    ) + "\n",
  );
  writeFileSync(
    join(SMEVALS_RUN_DIR, "timing.json"),
    JSON.stringify({ started_at: startedAt, completed_at: completedAt, duration_ms: durationMs }, null, 2) + "\n",
  );
  // Simulated usage/cost — the PoC never calls a real model.
  writeFileSync(
    join(SMEVALS_RUN_DIR, "usage.json"),
    JSON.stringify(
      {
        simulated: true,
        provider: resolvedConfiguration.model.provider,
        model: resolvedConfiguration.model.id,
        input_tokens: exitCode === 0 ? 128 : 0,
        output_tokens: exitCode === 0 ? 32 : 0,
        total_tokens: exitCode === 0 ? 160 : 0,
        cost: { amount_micros: 0, currency: "USD" },
      },
      null,
      2,
    ) + "\n",
  );
  writeFileSync(
    join(SMEVALS_RUN_DIR, "completion.json"),
    JSON.stringify(
      {
        status,
        exit_code: exitCode,
        scenario,
        task: SMEVALS_TASK,
        prompt: SMEVALS_PROMPT,
        ...(failure ? { failure } : {}),
      },
      null,
      2,
    ) + "\n",
  );
  if (stderr) writeFileSync(join(SMEVALS_RUN_DIR, "stderr.txt"), `${stderr}\n`);
}

function writeFailureArtifacts(error) {
  const message = error instanceof Error ? error.message : String(error);
  const completedAt = new Date().toISOString();
  const providerNeutralTrace = mapAgentTurnToTrace({ transcript: [] });
  const writeJson = (name, value) => {
    writeFileSync(join(SMEVALS_RUN_DIR, name), JSON.stringify(value, null, 2) + "\n");
  };

  writeJson("trace.json", providerNeutralTrace);
  writeJson("artifacts.json", executionArtifactsFromTrace(providerNeutralTrace));
  try {
    writeJson("agent-configuration.json", credentialFreeAgentConfiguration(config.agent_configuration));
  } catch {
    // A malformed configuration is itself diagnostic; do not fabricate a resolved snapshot.
  }
  writeJson("harness-version.json", {
    harness_version: harnessVersion,
    runner_contract_version: "1",
    source: `eval/validation-harness/configs/${configName}.yaml`,
  });
  writeJson("timing.json", {
    started_at: startedAt,
    completed_at: completedAt,
    duration_ms: Date.now() - t0,
  });
  writeJson("usage.json", {
    simulated: true,
    provider: config.agent_configuration?.model?.provider ?? "unknown",
    model: config.agent_configuration?.model?.id ?? SMEVALS_MODEL ?? "unknown",
    input_tokens: 0,
    output_tokens: 0,
    total_tokens: 0,
    cost: { amount_micros: 0, currency: "USD" },
  });
  writeJson("completion.json", {
    status: "runner_failed",
    exit_code: 42,
    scenario,
    task: SMEVALS_TASK,
    prompt: SMEVALS_PROMPT,
    failure: { kind: "runner_error", message },
  });
  writeFileSync(join(SMEVALS_RUN_DIR, "stderr.txt"), `${message}\n`);
  return message;
}

try {
  if (configurationFailure) throw configurationFailure;
  if (config.agent_configuration_id !== config.agent_configuration?.id) {
    throw new TypeError("Config agent_configuration_id must match agent_configuration.id.");
  }
  const result = runDeterministicAdapter({
    taskName: SMEVALS_TASK,
    scenario,
    skill,
    expectedTool,
    expectedArgs,
    delegateTo,
    forbiddenTool,
    flakyTool,
    expectInfraFailure,
  });
  writeArtifacts(result.turn, result.status, result.exitCode, result.failure, result.stderr);
  if (result.stderr) console.error(result.stderr);
  if (result.output) console.log(result.output);
  process.exit(result.exitCode);
} catch (error) {
  console.error(writeFailureArtifacts(error));
  process.exit(42);
}
